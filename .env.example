# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env — it is in .gitignore.
#
# Resolution order for every key is: process environment → .env → default.
# On a server, prefer real environment variables: they win over this file and
# the Settings page will show them as read-only.
# ---------------------------------------------------------------------------

# --- Canvas (required) -----------------------------------------------------
# Base URL without /api/v1
CANVAS_URL=https://your-school.instructure.com
# Account → Settings → "+ New access token"
CANVAS_TOKEN=

# --- ElevenLabs (required for audio) ---------------------------------------
# https://elevenlabs.io → Profile → API key
ELEVENLABS_API_KEY=

# --- Optional AI text processing -------------------------------------------
# Only needed if you pick OpenAI or Anthropic. Default is "Ingen AI".
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional SoundCloud publishing ----------------------------------------
# Requires a SoundCloud Artist Pro subscription and a manually approved API app:
# https://developers.soundcloud.com/docs/api/register-app
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
# Must match the redirect URI registered with SoundCloud exactly.
SOUNDCLOUD_REDIRECT_URI=http://localhost:8000/api/soundcloud/callback

# --- Application -----------------------------------------------------------
# Set a password to require login. Leave empty for an open local instance.
APP_PASSWORD=
# Signs session cookies and encrypts stored OAuth tokens.
# If unset, the app generates one on first start and saves it to .env, so logins
# and the SoundCloud connection survive a restart. Changing it later means
# reconnecting SoundCloud. On a server, set it as an environment variable:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Set to 1 when serving over HTTPS so the session cookie gets the Secure flag.
HTTPS_ONLY=0

# --- Paths and behaviour (all optional) ------------------------------------
# DATABASE_URL=sqlite:////data/canvas_audio.db
# DATA_DIR=./data
# OUTPUT_DIR=./output
# PRICING_FILE=./pricing.toml
# LOG_LEVEL=INFO
# HTTP_TIMEOUT=60
